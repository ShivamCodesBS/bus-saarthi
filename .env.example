# ============================================================
# Bus Saarthi — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── PostgreSQL Database (Supabase) ──────────────────────────
# Production (Supabase, direct connection):
#   postgresql://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres?sslmode=require
#
# If the direct host does not resolve (IPv6-only DNS in some networks),
# use the session pooler instead — it is IPv4:
#   postgresql://postgres.<PROJECT>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Local development:
#   postgresql://postgres:password@localhost:5432/bus_saarthi
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.CHANGEME.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:CHANGE_ME@db.CHANGEME.supabase.co:5432/postgres?sslmode=require

# ── Redis (optional — falls back to in-memory if unavailable) ──
# For Upstash Redis (serverless):
#   UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
#   UPSTASH_REDIS_REST_TOKEN=your-token
#
# For local Redis:
#   REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── JWT Auth ──────────────────────────────────────────────────
# REQUIRED in production. Generate a strong random string (64+ chars).
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── Webhook / Hardware Token ──────────────────────────────────
# Used to authenticate sensor data uploads from mobile app.
# REQUIRED in production.
WEBHOOK_SECRET=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# localhost:5173 and *.vercel.app are always allowed.
# Example: https://bussaarthi.com,https://admin.bussaarthi.com
CORS_ORIGINS=

# ── Cloudinary (Image Uploads) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Android Push (FCM) ────────────────────────────────────────
# Paste the ENTIRE service-account JSON from the Firebase console as one
# line. Leave empty to disable Android push (in-app notifications still work).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Web Push Notifications (VAPID) ────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@bussaarthi.com

# ── Bull Queue (uses Redis URL above) ─────────────────────────
# No extra config needed — Bull reuses REDIS_URL

# ── Upstash Redis (REST API) — Alternative to standard Redis ───
# If you use Upstash, set these instead of REDIS_URL:
# UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

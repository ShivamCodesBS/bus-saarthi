# ============================================================
# Bus Saarthi — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── PostgreSQL Database ────────────────────────────────────
# Local: postgresql://postgres:password@localhost:5432/bus_saarthi
# Docker: postgresql://postgres:password@postgres:5432/bus_saarthi
DATABASE_URL=postgresql://postgres:password@localhost:5432/bus_saarthi

# ── Redis (optional — falls back to in-memory if unavailable) ──
REDIS_URL=redis://localhost:6379

# ── JWT Auth ────────────────────────────────────────────────
# REQUIRED in production. Generate a strong random string (64+ chars).
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── Webhook / Hardware Token ────────────────────────────────
# Used to authenticate sensor data uploads from mobile app.
# REQUIRED in production.
WEBHOOK_SECRET=

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# localhost:5173 and *.vercel.app are always allowed.
# Example: https://bussaarthi.com,https://admin.bussaarthi.com
CORS_ORIGINS=

# ── Cloudinary (Image Uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Web Push Notifications (VAPID) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@bussaarthi.com

# ── Bull Queue (uses Redis URL above) ──────────────────────
# No extra config needed — Bull reuses REDIS_URL

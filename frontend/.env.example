# Frontend environment variables
# Copy to .env and fill in values

# Backend API URL (set in Vercel/Netlify env vars for production)
VITE_API_URL=https://bus-saarthi-j3lq.onrender.com

# VAPID Public Key for Web Push Notifications
# Generate with: npx web-push generate-vapid-keys (on backend)
# Then copy the public key here
VITE_VAPID_PUBLIC_KEY=
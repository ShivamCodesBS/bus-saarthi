generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // NOTE: no `directUrl` here on purpose. Prisma 5.22 hard-requires it, and
  // a missing DIRECT_URL aborted the entire deploy with
  // "Environment variable not found: DIRECT_URL". It is only used for
  // Prisma Migrate's shadow database, which this project does not use, so
  // DATABASE_URL alone is enough.
}

model User {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginId           String             @unique @map("login_id") @db.VarChar(50)
  name              String             @db.VarChar(100)
  password          String?
  role              UserRole
  routeId           String?            @map("route_id")
  feeStatus         FeeStatus          @default(unpaid) @map("fee_status")
  phone             String?            @db.VarChar(20)
  email             String?            @db.VarChar(100)
  profilePic        String?            @map("profile_pic")
  designation       String?            @db.VarChar(100)
  lastLogin         DateTime?          @map("last_login") @db.Timestamptz(6)
  locationLat       Float?             @map("location_lat")
  locationLng       Float?             @map("location_lng")
  licenseNumber     String?            @map("license_number") @db.VarChar(50)
  licenseExpiry     DateTime?          @map("license_expiry") @db.Timestamptz(6)
  experienceYears   Int?               @map("experience_years")
  bloodGroup        String?            @map("blood_group") @db.VarChar(10)
  parentName        String?            @map("parent_name") @db.VarChar(100)
  parentPhone       String?            @map("parent_phone") @db.VarChar(20)
  dob               DateTime?          @db.Timestamptz(6)
  address           String?
  gradeClass        String?            @map("grade_class") @db.VarChar(50)
  faceEnrolledAt    DateTime?          @map("face_enrolled_at") @db.Timestamptz(6)
  awsFaceId         String?            @map("aws_face_id") @db.VarChar(100)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  wakeAlarm         Json?              @map("wake_alarm") @db.Json
  /// Subject taught — only meaningful for the `teacher` role.
  subject           String?            @db.VarChar(100)
  attendanceRecords Attendance[]
  grievanceUpvotes  GrievanceUpvote[]
  grievances        Grievance[]
  leaves            Leave[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  route             Route?             @relation(fields: [routeId], references: [routeId])
  childLinks        ParentChildLink[]  @relation("ChildLinks")
  parentLinks       ParentChildLink[]  @relation("ParentLinks")

  @@index([role])
  @@index([routeId])
  @@index([phone])
  @@map("users")
}

/// A physical bus. A Route points at the Bus currently serving it, so a bus can
/// be swapped onto a different route (or a route can be merged into another
/// route's bus) without the route identity ever changing.
model Bus {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  busNumber          String     @unique @map("bus_number") @db.VarChar(30)
  registrationNumber String?    @map("registration_number") @db.VarChar(50)
  vehicleModel       String?    @map("vehicle_model") @db.VarChar(100)
  seatingCapacity    Int?       @map("seating_capacity")
  status             BusStatus  @default(active)
  notes              String?
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  routes             Route[]

  @@map("buses")
}

model Route {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId            String    @unique @map("route_id") @db.VarChar(50)
  routeName          String    @map("route_name") @db.VarChar(100)
  busNumber          String    @map("bus_number") @db.VarChar(30)
  busId              String?   @map("bus_id") @db.Uuid
  driverId           String?   @map("driver_id") @db.VarChar(50)
  stops              String
  city               String    @default("Bareilly") @db.VarChar(50)
  vehicleModel       String?   @map("vehicle_model") @db.VarChar(100)
  registrationNumber String?   @map("registration_number") @db.VarChar(50)
  seatingCapacity    Int?      @map("seating_capacity")
  insuranceExpiry    DateTime? @map("insurance_expiry") @db.Timestamptz(6)
  speedLimit         Int       @default(60) @map("speed_limit")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users              User[]
  bus                Bus?      @relation(fields: [busId], references: [id], onDelete: SetNull)

  @@index([busId])
  @@map("routes")
}

model Attendance {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passengerId     String     @map("passenger_id") @db.VarChar(50)
  routeId         String     @map("route_id") @db.VarChar(20)
  name            String?    @db.VarChar(100)
  feeStatus       FeeStatus? @map("fee_status")
  confidence      Float?     @db.Real
  timestamp       DateTime   @default(now()) @db.Timestamptz(6)
  originalRouteId String?    @map("original_route_id") @db.VarChar(20)
  mergeEventId    String?    @map("merge_event_id") @db.Uuid
  passenger       User       @relation(fields: [passengerId], references: [loginId], onDelete: Cascade)

  @@index([timestamp])
  @@index([passengerId, timestamp])
  @@index([routeId, timestamp])
  @@map("attendance")
}

/// A bus-service grievance. It is anchored to a *route* (stable identity) and
/// not to a bus number, because the bus serving a route can change (merges,
/// fleet swaps) while the route itself stays the same.
model Grievance {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginId       String            @map("login_id") @db.VarChar(50)
  /// Route id the grievance was raised against — stable across bus changes.
  route         String            @db.VarChar(20)
  /// Bus number serving the route at the moment the grievance was raised.
  /// Kept only as a historical snapshot; the live bus is resolved dynamically.
  busNumber     String?           @map("bus_number") @db.VarChar(30)
  text          String
  realName      String?           @map("real_name") @db.VarChar(100)
  type          String?           @db.VarChar(50)
  mediaUrl      String?           @map("media_url")
  status        GrievanceStatus   @default(pending)
  upvotes       Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  category      String?           @db.VarChar(100)
  /// Admin's reply to the complainant.
  adminResponse String?           @map("admin_response")
  /// Internal note attached while resolving.
  resolutionNote String?          @map("resolution_note")
  resolvedAt    DateTime?         @map("resolved_at") @db.Timestamptz(6)
  resolvedBy    String?           @map("resolved_by") @db.VarChar(50)
  /// When the complainant confirmed the fix (the only way a grievance closes).
  confirmedAt   DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  /// How many times the complainant rejected the resolution and reopened it.
  reopenCount   Int               @default(0) @map("reopen_count")
  /// Deadline by which the complainant must confirm the resolution.
  dueAt         DateTime?         @map("due_at") @db.Timestamptz(6)
  /// Bumped every time the grievance is reopened, so unsatisfied complaints
  /// sort to the top of the admin triage queue.
  priority      Int               @default(0)
  upvoteRecords GrievanceUpvote[]
  user          User              @relation(fields: [loginId], references: [loginId], onDelete: Cascade)
  notifications Notification[]

  @@index([status])
  @@index([route])
  @@index([loginId])
  @@index([createdAt])
  @@map("grievances")
}

model GrievanceUpvote {
  grievanceId String    @map("grievance_id") @db.Uuid
  loginId     String    @map("login_id") @db.VarChar(50)
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [loginId], references: [loginId], onDelete: Cascade)

  @@id([grievanceId, loginId])
  @@map("grievance_upvotes")
}

model Leave {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginId String   @map("login_id") @db.VarChar(50)
  date    DateTime @db.Date
  user    User     @relation(fields: [loginId], references: [loginId], onDelete: Cascade)

  @@unique([loginId, date])
  @@map("leaves")
}

model SystemLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level     LogLevel @default(log)
  message   String
  context   String?  @db.VarChar(255)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("system_logs")
}

model Broadcast {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message   String
  title     String?  @db.VarChar(200)
  timestamp DateTime @default(now()) @map("timestamp") @db.Timestamptz(6)

  @@map("broadcasts")
}

model PushSubscription {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginId      String @map("login_id") @db.VarChar(50)
  subscription Json
  deviceType   String @default("web") @map("device_type") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User   @relation(fields: [loginId], references: [loginId], onDelete: Cascade)

  @@index([loginId])
  @@map("push_subscriptions")
}

/// In-app notification. Persisted so a user sees the grievance state change
/// even if the browser was closed when the push arrived.
model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginId     String   @map("login_id") @db.VarChar(50)
  title       String   @db.VarChar(200)
  body        String
  type        String   @default("info") @db.VarChar(50)
  grievanceId String?  @map("grievance_id") @db.Uuid
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [loginId], references: [loginId], onDelete: Cascade)
  grievance   Grievance? @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@index([loginId, read])
  @@index([createdAt])
  @@map("notifications")
}

model SosAlert {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginId   String   @map("login_id") @db.VarChar(50)
  passenger String?  @db.VarChar(100)
  route     String   @db.VarChar(20)
  time      DateTime @default(now()) @map("time") @db.Timestamptz(6)

  @@index([time])
  @@map("sos_alerts")
}

model Telemetry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId       String   @default("4") @map("route_id") @db.VarChar(20)
  latitude      Float?
  longitude     Float?
  gpsSpeedKnots Float?   @map("gps_speed_knots") @db.Real
  mpuSpeedKmh   Float?   @map("mpu_speed_kmh") @db.Real
  headingDeg    Float?   @map("heading_deg") @db.Real
  timestamp     DateTime @default(now()) @map("timestamp") @db.Timestamptz(6)

  @@index([routeId, timestamp])
  @@map("telemetry")
}

model ParentChildLink {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentLoginId String   @map("parent_login_id") @db.VarChar(50)
  childLoginId  String   @map("child_login_id") @db.VarChar(50)
  nickname      String?  @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  parent        User     @relation("ParentLinks", fields: [parentLoginId], references: [loginId], onDelete: Cascade)
  child         User     @relation("ChildLinks", fields: [childLoginId], references: [loginId], onDelete: Cascade)

  @@unique([parentLoginId, childLoginId])
  @@index([childLoginId])
  @@map("parent_child_links")
}

model MergeEvent {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cancelledRouteId   String      @map("cancelled_route_id") @db.VarChar(50)
  targetRouteId      String      @map("target_route_id") @db.VarChar(50)
  reason             MergeReason @default(low_attendance)
  status             MergeStatus @default(active)
  initiatedBy        String      @map("initiated_by") @db.VarChar(50)
  studentsMoved      Int         @default(0) @map("students_moved")
  cancelledBusNumber String?     @map("cancelled_bus_number") @db.VarChar(30)
  targetBusNumber    String?     @map("target_bus_number") @db.VarChar(30)
  cancelledRouteName String?     @map("cancelled_route_name") @db.VarChar(100)
  targetRouteName    String?     @map("target_route_name") @db.VarChar(100)
  notes              String?
  mergedAt           DateTime    @default(now()) @map("merged_at") @db.Timestamptz(6)
  unmergedAt         DateTime?   @map("unmerged_at") @db.Timestamptz(6)
  expiresAt          DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([cancelledRouteId, status])
  @@index([targetRouteId, status])
  @@map("merge_events")
}

enum UserRole {
  passenger
  teacher
  admin
  driver
  transport_incharge
  tech_admin
  parent
}

enum FeeStatus {
  paid
  unpaid
  partial
}

/// Lifecycle of a grievance:
///  pending      -> freshly raised, waiting for triage
///  in_progress  -> an admin has acknowledged and is working on it
///  resolved     -> admin marked it fixed, waiting for the complainant to confirm
///  reopened     -> complainant rejected the fix, back in the queue with a higher priority
///  closed       -> complainant confirmed the fix; terminal state
enum GrievanceStatus {
  pending
  in_progress
  resolved
  reopened
  closed
}

enum BusStatus {
  active
  maintenance
  retired
}

enum LogLevel {
  log
  warn
  error
  debug
  verbose
  fatal
}

enum MergeStatus {
  active
  undone
  expired
}

enum MergeReason {
  low_attendance
  vehicle_breakdown
  driver_unavailable
  weather
  other
}
